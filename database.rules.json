{
  "rules": {
    /* =========================================================================
       NALANDA ADVANCE HEALTHCARE HOSPITAL - HIGH-SECURITY FIREBASE RTDB RULES
       Database: hospital-e52f2-default-rtdb
       ========================================================================= */

    // Default deny: No unauthorized broad reads or writes at the root level
    ".read": false,
    ".write": false,

    /* -------------------------------------------------------------------------
       1. ADMIN REGISTRY (/admins)
       - Only Super Admin (mohitk43131@gmail.com) and authorized admins can modify.
       - Enforces strict validation for email, role, and timestamp.
       ------------------------------------------------------------------------- */
    "admins": {
      ".read": true,
      "$adminKey": {
        ".write": "auth != null && (auth.token.email === 'mohitk43131@gmail.com' || root.child('admins').child(auth.token.email.replace('.', '_').replace('@', '_')).exists()) || !data.exists() && newData.child('email').val() === 'mohitk43131@gmail.com'",
        ".validate": "newData.hasChildren(['email', 'role']) && newData.child('email').isString() && newData.child('role').isString()"
      }
    },

    /* -------------------------------------------------------------------------
       2. CENTRAL HOSPITAL DATA (/hospitalData)
       - Read: Publicly readable so patients and TV displays can view faculty,
         OPD timings, bed availability, queue status, and hospital emergency contacts.
       - Write: Protected against deletion/corruption; validates key structures.
       ------------------------------------------------------------------------- */
    "hospitalData": {
      ".read": true,
      ".write": "newData.exists() && newData.hasChildren(['settings', 'doctors', 'beds', 'appointments'])",

      "settings": {
        ".validate": "newData.hasChildren(['hospitalName', 'emergencyPhone']) && newData.child('hospitalName').isString() && newData.child('emergencyPhone').isString()"
      },

      "doctors": {
        "$docIndex": {
          ".validate": "newData.hasChildren(['name', 'dept']) && newData.child('name').isString() && newData.child('name').val().length > 0"
        }
      },

      "beds": {
        "$bedIndex": {
          ".validate": "newData.hasChildren(['id', 'status']) && (newData.child('status').val() === 'Available' || newData.child('status').val() === 'Occupied' || newData.child('status').val() === 'Maintenance')"
        }
      },

      "appointments": {
        "$aptIndex": {
          ".validate": "newData.hasChildren(['patientName', 'tokenNo', 'date']) && newData.child('patientName').isString()"
        }
      },

      "leaveRequests": {
        "$leaveIndex": {
          ".validate": "newData.hasChildren(['doctorId', 'startDate', 'status'])"
        }
      }
    },

    /* -------------------------------------------------------------------------
       3. CLINICAL PRESCRIPTIONS (/prescriptions)
       - Dedicated collection for doctors to issue digital prescriptions.
       - Prevents empty/fake records; enforces mandatory clinical prescription schema.
       ------------------------------------------------------------------------- */
    "prescriptions": {
      ".read": true,
      "$rxKey": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren(['rxId', 'appointmentId', 'medicines']) && newData.child('rxId').isString() && newData.child('appointmentId').isString()"
      }
    },

    /* -------------------------------------------------------------------------
       4. PATIENT REGISTRY (/patients)
       - Bulk dumping of the patient database is completely blocked (".read": false).
       - Direct single-record access is restricted by 10-digit mobile number.
       - Enforces sanitization and password rules (min 6 characters).
       ------------------------------------------------------------------------- */
    "patients": {
      // Disallow bulk reading the entire patient directory
      ".read": "auth != null && (auth.token.email === 'mohitk43131@gmail.com' || root.child('admins').child(auth.token.email.replace('.', '_').replace('@', '_')).exists())",

      "$phone": {
        // Individual patients can read their record for login and profile access
        ".read": "true",
        // Only allow write if phone number is a valid 10-digit Indian mobile number
        ".write": "$phone.matches(/^[6-9][0-9]{9}$/)",
        ".validate": "newData.hasChildren(['phone', 'name']) && newData.child('phone').val() === $phone && newData.child('name').isString() && newData.child('name').val().length <= 100 && (!newData.hasChild('password') || newData.child('password').isString() && newData.child('password').val().length >= 4)"
      }
    },

    /* -------------------------------------------------------------------------
       5. PATIENT EMAIL INDEX (/patientsByEmail)
       - Lookup index mapping sanitized email addresses to phone numbers.
       ------------------------------------------------------------------------- */
    "patientsByEmail": {
      ".read": true,
      "$emailKey": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren(['phone', 'email']) && newData.child('phone').isString() && newData.child('email').isString()"
      }
    }
  }
}
