{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": true,
      "$adminKey": {
        ".write": "auth != null || (!data.exists() && newData.child('email').val() === 'mohitk43131@gmail.com')",
        ".validate": "!newData.exists() || (newData.hasChildren(['email', 'role']) && newData.child('email').isString() && newData.child('role').isString())"
      }
    },
    "hospitalData": {
      ".read": true,
      ".write": "newData.exists() && newData.hasChildren(['settings', 'doctors', 'beds', 'appointments'])",
      "settings": {
        ".validate": "newData.hasChildren(['hospitalName', 'emergencyPhone']) && newData.child('hospitalName').isString() && newData.child('emergencyPhone').isString()"
      },
      "doctors": {
        "$docIndex": {
          ".validate": "newData.hasChildren(['name', 'dept']) && newData.child('name').isString() && newData.child('name').val().length > 0"
        }
      },
      "beds": {
        "$bedIndex": {
          ".validate": "newData.hasChildren(['id', 'status']) && (newData.child('status').val() === 'Available' || newData.child('status').val() === 'Occupied' || newData.child('status').val() === 'Maintenance')"
        }
      },
      "appointments": {
        "$aptIndex": {
          ".validate": "newData.hasChildren(['patientName', 'tokenNo', 'date']) && newData.child('patientName').isString()"
        }
      },
      "leaveRequests": {
        "$leaveIndex": {
          ".validate": "newData.hasChildren(['doctorId', 'startDate', 'status'])"
        }
      }
    },
    "prescriptions": {
      ".read": true,
      "$rxKey": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren(['rxId', 'appointmentId', 'medicines']) && newData.child('rxId').isString() && newData.child('appointmentId').isString()"
      }
    },
    "patients": {
      ".read": true,
      "$phone": {
        ".write": "$phone.matches(/^[6-9][0-9]{9}$/)",
        ".validate": "!newData.exists() || (newData.hasChildren(['phone', 'name']) && newData.child('phone').val() === $phone && newData.child('name').isString() && newData.child('name').val().length <= 100 && (!newData.hasChild('password') || (newData.child('password').isString() && newData.child('password').val().length >= 4)))"
      }
    },
    "patientsByEmail": {
      ".read": true,
      "$emailKey": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren(['phone', 'email']) && newData.child('phone').isString() && newData.child('email').isString() && newData.child('phone').val().matches(/^[6-9][0-9]{9}$/)"
      }
    }
  }
}
